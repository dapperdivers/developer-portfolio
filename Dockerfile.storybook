# Storybook Production Dockerfile
FROM node:22-alpine AS builder

WORKDIR /app

# Site Navigator environment variables - set at runtime
ENV VITE_SITE_MAIN_URL=""
ENV VITE_SITE_STORYBOOK_URL=""
ENV VITE_SITE_DOCS_URL=""
ENV VITE_SITE_NAVIGATOR_ENABLED="true"

# Install dependencies first (better layer caching)
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --production=false --network-timeout 600000 --silent

# Copy only files needed for Storybook build (better layer caching)
COPY .storybook/ ./.storybook/
COPY src/ ./src/
COPY public/ ./public/
COPY config/ ./config/
COPY scripts/ ./scripts/
COPY vite.config.ts tsconfig.json ./

# Build the site navigator and Storybook (optimized with quiet flag)
RUN if [ "${VITE_SITE_NAVIGATOR_ENABLED}" = "true" ]; then \
        yarn build:site-navigator; \
    fi && \
    yarn storybook:build --quiet

# Production stage
FROM nginx:alpine

# Create user, setup permissions, and install dependencies in one layer
RUN addgroup -g 1001 -S storybook && \
    adduser -u 1001 -S -G storybook -s /sbin/nologin storybook && \
    apk upgrade --no-cache && \
    # Setup nginx directories for non-root (wget already available)
    mkdir -p /var/cache/nginx/client_temp && \
    chown -R storybook:storybook /var/cache/nginx /var/log/nginx /var/run && \
    chmod 755 /var/cache/nginx && \
    rm -rf /var/cache/apk/* /tmp/* /var/tmp/*

# Copy built storybook with correct ownership
COPY --from=builder --chown=storybook:storybook /app/storybook-static /usr/share/nginx/html

# Copy configs with correct ownership
COPY --chown=storybook:storybook nginx-storybook.conf /etc/nginx/conf.d/default.conf
COPY docker-entrypoint-storybook.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh && \
    # More thorough cleanup
    find /usr/share/nginx/html -name "*.md" -delete && \
    find /usr/share/nginx/html -name "Dockerfile*" -delete && \
    find /usr/share/nginx/html -name ".git*" -delete && \
    find /usr/share/nginx/html -name "node_modules" -type d -exec rm -rf {} + 2>/dev/null || true

EXPOSE 6006

# Health check with wget and better validation
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider -S http://localhost:6006/ 2>&1 | grep -q "200 OK" || exit 1

# Add security labels
LABEL security.non-root=true \
      security.user=storybook

# Switch to non-root user
USER storybook

# Start nginx as non-root user with runtime configuration
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]