# Storybook Production Dockerfile
FROM node:22-slim AS builder

WORKDIR /app

# Site Navigator environment variables - set at runtime
ENV VITE_SITE_MAIN_URL=""
ENV VITE_SITE_STORYBOOK_URL=""
ENV VITE_SITE_DOCS_URL=""
ENV VITE_SITE_NAVIGATOR_ENABLED="true"

# Install dependencies (better layer caching)
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --production=false --network-timeout 600000 --silent

# Copy source files
COPY . .

# Build the site navigator and Storybook (combined for efficiency)
RUN if [ "${VITE_SITE_NAVIGATOR_ENABLED}" = "true" ]; then yarn build:site-navigator; fi && \
    yarn storybook:build

# Production stage
FROM nginx:alpine

# Install curl for healthcheck
RUN apk --no-cache add curl

# Copy built storybook to nginx
COPY --from=builder /app/storybook-static /usr/share/nginx/html

# Copy custom nginx config and entrypoint script for Storybook
COPY nginx-storybook.conf /etc/nginx/conf.d/default.conf
COPY docker-entrypoint-storybook.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Remove unnecessary files that shouldn't be served
RUN rm -f /usr/share/nginx/html/.htaccess \
    && rm -f /usr/share/nginx/html/Dockerfile \
    && rm -f /usr/share/nginx/html/nginx-storybook.conf

# Create non-root user
RUN addgroup -S storybook && adduser -S -G storybook storybook \
    && chown -R storybook:storybook /usr/share/nginx/html \
    && chown -R storybook:storybook /var/cache/nginx \
    && chown -R storybook:storybook /var/log/nginx \
    && chown -R storybook:storybook /etc/nginx/conf.d \
    && touch /var/run/nginx.pid \
    && chown -R storybook:storybook /var/run/nginx.pid

EXPOSE 6006

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:6006/ || exit 1

# Switch to non-root user
USER storybook

# Start nginx as non-root user with runtime configuration
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]