# Storybook Production Dockerfile
FROM node:22-slim AS builder

WORKDIR /app

# Install dependencies
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --network-timeout 600000

# Copy source files
COPY . .

# Build Storybook
RUN yarn storybook:build

# Production stage
FROM nginx:alpine

# Install curl for healthcheck
RUN apk --no-cache add curl

# Copy built storybook to nginx
COPY --from=builder /app/storybook-static /usr/share/nginx/html

# Copy custom nginx config for Storybook
COPY nginx-storybook.conf /etc/nginx/conf.d/default.conf

# Create non-root user
RUN addgroup -S storybook && adduser -S -G storybook storybook
RUN chown -R storybook:storybook /usr/share/nginx/html

EXPOSE 6006

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:6006/ || exit 1

CMD ["nginx", "-g", "daemon off;"]