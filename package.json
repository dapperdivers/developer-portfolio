{
  "name": "developer-portfolio",
  "version": "1.0.0",
  "type": "module",
  "description": "Software Developer Portfolio Template built with react.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "yarn@1.22.22",
  "repository": "https://github.com/DapperDivers/developer-portfolio.git",
  "author": "Derek Mackley",
  "license": "MIT",
  "dependencies": {
    "@iconify-json/logos": "^1.2.4",
    "@iconify-json/simple-icons": "^1.2.27",
    "@iconify-json/vscode-icons": "^1.2.16",
    "@iconify/react": "^6.0.4",
    "@vitejs/plugin-react": "^6.3.0",
    "axios": "^1.7.7",
    "classnames": "^2.5.1",
    "dotenv": "^18.0.10",
    "esbuild": "^0.28.2",
    "express": "^5",
    "express-rate-limit": "^8",
    "form-data": "^4.0.4",
    "framer-motion": "^14",
    "helmet": "^8.0.0",
    "leaflet": "^1.9.4",
    "node-fetch": "^3.3.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^3.1.0",
    "react-icons": "^5.5.0",
    "smoothscroll-polyfill": "^0.4.4",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-build": "^7.3.0",
    "workbox-window": "^7.3.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "./scripts/dev-all.sh",
    "dev:all:full": "concurrently --kill-others --prefix-colors \"cyan,magenta,yellow,green\" --prefix \"[{name}]\" --names \"vite,storybook,docs,server\" --timestamp-format \"HH:mm:ss\" \"vite --port 5173 --host\" \"storybook dev -p 6006 --host 0.0.0.0\" \"cd docs && bundle install && bundle exec jekyll serve --watch --livereload --host 0.0.0.0\" \"PORT=3001 node config/vite/dev/server.js\"",
    "dev:frontend": "concurrently --kill-others --prefix-colors \"cyan,magenta\" --prefix \"[{name}]\" --names \"vite,storybook\" --timestamp-format \"HH:mm:ss\" \"vite\" \"storybook dev -p 6006 --host 0.0.0.0\"",
    "dev:minimal": "concurrently --kill-others --prefix-colors \"cyan,green\" --prefix \"[{name}]\" --names \"vite,server\" --timestamp-format \"HH:mm:ss\" \"vite\" \"node config/vite/dev/server.js\"",
    "dev:docs": "cd docs && bundle install && bundle exec jekyll serve --watch --livereload --host 0.0.0.0",
    "dev:status": "node scripts/dev-status.js",
    "preview": "vite preview",
    "preview:prod": "PREVIEW_PORT=5173 PREVIEW_HOST=0.0.0.0 vite preview",
    "preview:custom": "vite preview --host ${PREVIEW_HOST:-0.0.0.0} --port ${PREVIEW_PORT:-4173}",
    "serve": "node config/vite/dev/server.js",
    "start": "NODE_ENV=production PORT=8080 node config/vite/prod/server.js",
    "start:prod": "npm run build:prod && NODE_ENV=production PORT=8080 node config/vite/prod/server.js",
    "build": "vite build",
    "build:prod": "NODE_ENV=production vite build",
    "build:dev": "NODE_ENV=development vite build",
    "build:analyze": "ANALYZE=true vite build",
    "build:full": "npm-run-all check build:prod",
    "build:all": "npm-run-all build storybook:build build:docs",
    "build:docs": "cd docs && bundle exec jekyll build --destination ../_site || echo 'Jekyll build skipped'",
    "storybook": "storybook dev -p 6006 --host 0.0.0.0",
    "storybook:build": "storybook build --output-dir=storybook-static",
    "storybook:test": "test-storybook",
    "generate-story": "node scripts/generate.js story",
    "test": "vitest --config vitest.config.ts",
    "test:watch": "vitest --watch --config vitest.config.ts",
    "test:run": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "verify": "npm-run-all typecheck lint test:run build storybook:build",
    "check": "npm-run-all --parallel typecheck lint",
    "check:fix": "npm-run-all format lint:fix typecheck",
    "check:ci": "npm-run-all typecheck lint:ci",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "lint:ci": "eslint src --ext .js,.jsx,.ts,.tsx --max-warnings 9999 --format @microsoft/eslint-formatter-sarif --output-file eslint-results.sarif",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "optimize": "npm-run-all optimize:*",
    "optimize:images": "node scripts/optimize-images.js",
    "optimize:svgs": "node scripts/optimize-svgs.js",
    "clean": "rm -rf node_modules .cache dist build",
    "clean:all": "npm-run-all clean clean:build",
    "clean:build": "rm -rf build",
    "reinstall": "yarn clean && yarn",
    "validate": "node scripts/validate-config.js",
    "generate": "node scripts/generate-asset-metadata.js",
    "generate:component": "node scripts/generate.js"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "resolutions": {
    "form-data": "^4.0.4"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "form-data": "^4.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.51.0",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-links": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.2.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/testing-library__react": "^10.2.0",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@vitest/coverage-v8": "^5.1.1",
    "autoprefixer": "^10.7.0",
    "chalk": "^6.0.1",
    "concurrently": "^10.0.7",
    "cssnano": "^9.9.0",
    "eslint": "^10.15.0",
    "eslint-plugin-module-resolver": "^1.5.0",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-storybook": "^10.6.7",
    "glob": "^14.0.6",
    "globals": "^17.14.0",
    "jiti": "^2.4.2",
    "jsdom": "^31.0.1",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.50.1",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "rollup-plugin-visualizer": "^7.1.3",
    "sharp": "^0.35.5",
    "storybook": "^10.6.7",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
