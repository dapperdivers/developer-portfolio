# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# OS generated files
Thumbs.db
# Helm build files
*.tgz
# Test files
*_test.yaml
test/
tests/
# Documentation that shouldn't be packaged (comment out if you want to include)
# README.md
# SECURITY.md
NOTES.md

# OCI and CI/CD related files
.github/
.gitignore
.helmignore
Dockerfile*
docker-compose*

# Package manager files
package.json
package-lock.json
yarn.lock
node_modules/

# Build artifacts
dist/
build/
.next/
.nuxt/
target/

# Environment files
.env*
!.env.example