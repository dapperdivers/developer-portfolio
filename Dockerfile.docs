# Stage 1: Node.js stage for site navigator
FROM node:22-alpine AS node-builder

WORKDIR /app

# Site Navigator environment variables - set at runtime
ENV VITE_SITE_MAIN_URL=""
ENV VITE_SITE_STORYBOOK_URL=""
ENV VITE_SITE_DOCS_URL=""
ENV VITE_SITE_NAVIGATOR_ENABLED="true"

# Copy only necessary files for site navigator build
COPY package.json ./
COPY scripts/ ./scripts/
COPY src/components/shared/SiteNavigator.js ./src/components/shared/

# Install minimal dependencies and build
RUN npm install fs-extra --silent && \
    node scripts/build-site-navigator.js

# Stage 2: Ruby/Jekyll build
FROM ruby:3.1-alpine AS builder

# Install build dependencies efficiently
RUN apk add --no-cache --virtual .build-deps \
    build-base \
    linux-headers \
    git \
    && apk add --no-cache \
    nodejs

WORKDIR /docs

# Copy and install gems first (better layer caching)
COPY docs/Gemfile docs/Gemfile.lock ./
RUN bundle config --global frozen 1 && \
    bundle config --global silence_root_warning 1 && \
    bundle install --without development test --jobs $(nproc) --retry 3 --quiet

# Copy docs source files
COPY docs/ ./

# Copy built site navigator from Node stage
COPY --from=node-builder /app/public/site-navigator.js ./assets/js/

# Build Jekyll site with optimizations
ARG JEKYLL_BASEURL=""
ARG JEKYLL_ENV=production
RUN JEKYLL_ENV=${JEKYLL_ENV} bundle exec jekyll build ${JEKYLL_BASEURL:+--baseurl "$JEKYLL_BASEURL"} && \
    # Cleanup build dependencies
    apk del .build-deps

# Stage 3: Production
FROM nginx:alpine

# Create user, setup permissions and security in one layer
RUN addgroup -g 1001 -S jekyll && \
    adduser -u 1001 -S -G jekyll -s /sbin/nologin jekyll && \
    apk upgrade --no-cache && \
    mkdir -p /var/cache/nginx/client_temp && \
    chown -R jekyll:jekyll /var/cache/nginx /var/log/nginx /var/run && \
    chmod 755 /var/cache/nginx && \
    rm -rf /var/cache/apk/* /tmp/* /var/tmp/*

# Copy built site with correct ownership
COPY --from=builder --chown=jekyll:jekyll /docs/_site /usr/share/nginx/html

# Copy configs with correct ownership
COPY --chown=jekyll:jekyll docs/nginx.conf /etc/nginx/conf.d/default.conf
COPY docs/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh && \
    # Enhanced cleanup
    find /usr/share/nginx/html -name "Gemfile*" -delete && \
    find /usr/share/nginx/html -name "*.rb" -delete && \
    find /usr/share/nginx/html -name "_config.yml" -type f -delete && \
    find /usr/share/nginx/html -name ".git*" -delete && \
    rm -rf /usr/share/nginx/html/vendor /usr/share/nginx/html/.bundle

EXPOSE 4000

# Health check with wget and better validation
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider -S http://localhost:4000/ 2>&1 | grep -q "200 OK" || exit 1

# Add security labels
LABEL security.non-root=true \
      security.user=jekyll

# Switch to non-root user
USER jekyll

# Start nginx as non-root user with runtime config injection
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]