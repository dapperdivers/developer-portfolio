{
  "name": "developer-portfolio-blog",
  "private": true,
  "type": "module",
  "description": "derekmackley.com/blog: Astro site built from pushed articles, styled with the portfolio's design tokens. Never reads the vault.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "ARTICLES_DIR=fixtures/articles astro dev --port 4322",
    "build": "astro build",
    "build:fixtures": "ARTICLES_DIR=fixtures/articles astro build",
    "preview": "astro preview --port 4322",
    "publish:site": "node scripts/publish.ts",
    "check": "astro check",
    "test": "node --test 'scripts/**/*.test.ts'"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.10",
    "@astrojs/react": "7.1.9",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.6",
    "astro": "7.4.13",
    "framer-motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-callouts": "2.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "6.0.3"
  }
}
