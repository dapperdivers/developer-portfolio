---
import type { Post } from '../lib/posts';
import { formatDate, isoDate, readingMinutes, url } from '../lib/posts';
import TopicList from './TopicList.astro';

interface Props {
  post: Post;
  /** The index's newest post is shown larger */
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, description, published, topics } = post.data;
---

<article class:list={['post-card', { 'post-card--featured': featured }]}>
  <p class="post-card__meta">
    <time datetime={isoDate(published)}>{formatDate(published)}</time>
    <span aria-hidden="true">·</span>
    <span>{readingMinutes(post.body)} min read</span>
  </p>
  <h2 class="post-card__title">
    <a href={url(`${post.id}/`)}>{title}</a>
  </h2>
  <p class="post-card__description">{description}</p>
  <TopicList topics={topics} />
</article>
