---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import TopicList from '../components/TopicList.astro';
import { formatDate, getPosts, isoDate, readingMinutes, url, type Post } from '../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  // Newest first: "newer" is the one before, "older" the one after
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { title, description, published, updated, topics } = post.data;
const { Content } = await render(post);
---

<Base title={title} description={description} article={{ published, updated }}>
  <article class="post">
    <header class="post__header">
      <p class="kicker"><a href={url()}>~/blog</a>/{post.id}</p>
      <h1 class="post__title">{title}</h1>
      <p class="post__description">{description}</p>
      <p class="post__meta">
        <time datetime={isoDate(published)}>{formatDate(published)}</time>
        {updated && (
          <>
            <span aria-hidden="true">·</span>
            <span>updated <time datetime={isoDate(updated)}>{formatDate(updated)}</time></span>
          </>
        )}
        <span aria-hidden="true">·</span>
        <span>{readingMinutes(post.body)} min read</span>
      </p>
      <TopicList topics={topics} />
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>

  {(newer || older) && (
    <nav class="post-nav" aria-label="More posts">
      {older ? (
        <a class="post-nav__link" href={url(`${older.id}/`)}>
          <span class="post-nav__label">← Older</span>
          <span class="post-nav__title">{older.data.title}</span>
        </a>
      ) : <span />}
      {newer && (
        <a class="post-nav__link post-nav__link--newer" href={url(`${newer.id}/`)}>
          <span class="post-nav__label">Newer →</span>
          <span class="post-nav__title">{newer.data.title}</span>
        </a>
      )}
    </nav>
  )}
</Base>
