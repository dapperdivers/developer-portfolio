---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getTopics, url, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const topics = await getTopics();
  return [...topics.entries()].map(([topic, posts]) => ({ params: { topic }, props: { posts } }));
}

interface Props {
  posts: Post[];
}

const { topic } = Astro.params;
const { posts } = Astro.props;
---

<Base title={`#${topic}`} description={`Posts about ${topic}.`}>
  <header class="page-intro">
    <p class="kicker"><a href={url()}>~/blog</a>/topics/{topic}</p>
    <h1 class="page-intro__title">#{topic}</h1>
    <p class="page-intro__lede">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
  </header>
  <div class="post-list">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</Base>
