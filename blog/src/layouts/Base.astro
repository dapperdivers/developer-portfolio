---
// Shared shell: the portfolio's tokens and its real React components, so the blog
// reads as part of the same site as the resume, Storybook and the docs. The
// components render at build time only: the blog ships no JavaScript.
import '@tokens/index.css';
import '../styles/blog.css';
import HeaderName from '@atoms/HeaderName';
import SiteLinks from '@molecules/SiteLinks';
import { siteLinks } from '@/data/siteLinks';
import { url } from '../lib/posts';

interface Props {
  title: string;
  description: string;
  /** Article pages pass their dates for Open Graph */
  article?: { published: Date; updated?: Date };
}

const { title, description, article } = Astro.props;
const fullTitle = title === 'Blog' ? 'Blog | Derek Mackley' : `${title} | Derek Mackley`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const headerLinks = siteLinks.filter((link) => !link.external);
const year = new Date().getUTCFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Derek Mackley's blog" href={url('rss.xml')} />
    <meta name="theme-color" content="#2a2a2a" />
    <meta property="og:site_name" content="Derek Mackley" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article?.updated && <meta property="article:modified_time" content={article.updated.toISOString()} />}
    <!-- Same faces the portfolio loads -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Luxurious+Script&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="blog-header">
      <div class="blog-container blog-header__inner">
        <a class="blog-header__home" href="/" aria-label="Derek Mackley, back to the main site">
          <HeaderName name="Derek Mackley" logoSrc="/apple-touch-icon.png" animated={false} />
        </a>
        <SiteLinks links={headerLinks} currentId="blog" label="Docs, components and blog" />
      </div>
    </header>

    <main id="main" class="blog-container blog-main">
      <slot />
    </main>

    <footer class="blog-footer">
      <div class="blog-container blog-footer__inner">
        <span>© {year} Derek Mackley</span>
        <SiteLinks links={siteLinks} variant="footer" currentId="blog" label="Docs, components, blog and source" />
        <a class="blog-footer__rss" href={url('rss.xml')}>RSS</a>
      </div>
    </footer>
  </body>
</html>
